# RetailPulse Backend — copy to .env and adjust as needed
#   copy .env.example .env
# Generate a strong JWT secret:  openssl rand -base64 48

DB_HOST=localhost
DB_PORT=5432
DB_NAME=retailpulse_db
DB_USER=postgres
DB_PASSWORD=change-me

JWT_SECRET=generate-a-random-secret-of-at-least-32-characters

MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password

ALERT_EMAIL=alerts@example.com

RETAILPULSE_ADMIN_EMAIL=admin@example.com
RETAILPULSE_ADMIN_PASSWORD=choose-strong-password

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

AI_SERVICE_BASE_URL=http://localhost:8000/ml
AI_SERVICE_ENABLED=true

LOG_OTP_TO_CONSOLE=false

# Production (Render + Neon): instead of DB_HOST/PORT/NAME/USER/PASSWORD set:
#   SPRING_PROFILES_ACTIVE=prod
#   SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require
#   SPRING_DATASOURCE_USERNAME=<user>
#   SPRING_DATASOURCE_PASSWORD=<password>
